{
    "name": "pierre-granger/apidae-lecture",
    "description": "Classe d'utilisation des API de consultation d'Apidae",
    "require": {
        "php": "^8.4",
        "pierre-granger/apidae-core": "^0.8",
        "guzzlehttp/guzzle": "^7.2",
        "guzzlehttp/uri-template": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PierreGranger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PierreGranger\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}